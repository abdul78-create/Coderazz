# ==============================================================================
# CodeRazz — Environment Configuration Template
# Zero-Cost / Local-First Stack
# Copy this file to .env before starting services
# ==============================================================================

# Application Environment
ENV=development
APP_NAME=CodeRazz
APP_PORT=8001
FRONTEND_PORT=3000

# Security & Authentication (Generate random secret in production)
SECRET_KEY=coderazz_dev_secret_key_change_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_INITIAL_EMAIL=admin@coderazz.edu
ADMIN_INITIAL_PASSWORD=AdminInitial#2026

# Database Configuration (Explicit Modes: postgresql | sqlite)
DB_MODE=postgresql
POSTGRES_USER=coderazz_user
POSTGRES_PASSWORD=coderazz_local_password
POSTGRES_DB=coderazz_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://coderazz_user:coderazz_local_password@localhost:5433/coderazz_db
SQLITE_URL=sqlite+aiosqlite:///./coderazz_dev.db

# Execution Sandbox Configuration
SANDBOX_MODE=docker        # Options: docker, subprocess_fallback
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEM_LIMIT_MB=128
SANDBOX_TIMEOUT_SECONDS=3.0
SANDBOX_MAX_OUTPUT_BYTES=65536

# Optional Local LLM (Ollama) - Zero cost, runs entirely on user's hardware
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b

# Logging & Telemetry
LOG_LEVEL=INFO
DEBUG=true
